{
  "name": "objekt-granit",
  "version": "0.1.0",
  "private": true,
  "description": "Объект «Гранит» — 3D-симулятор командира секретного артиллерийского комплекса, 1944",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "play": "node scripts/play.cjs",
    "android": "npm run build && cd android && ./gradlew assembleRelease",
    "android:debug": "npm run build && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
